#!/bin/bash

# COLOR VALIDATION using tput
if [ -t 1 ]; then
    GREEN=$(tput setaf 2)
    YELLOW=$(tput setaf 3)
    RED=$(tput setaf 1)
    NC=$(tput sgr0)
else
    GREEN=""
    YELLOW=""
    RED=""
    NC=""
fi

check_curl() {
    if ! command -v curl &> /dev/null; then
        echo "Warning: 'curl' not found. Install it with 'apt install curl' for ISP lookup."
        return 1
    fi
    return 0
}

get_isp() {
    if check_curl; then
        curl -s --max-time 5 ipinfo.io/org 2>/dev/null | cut -d " " -f 2-10 || echo "N/A"
    else
        echo "N/A"
    fi
}

AUTH_LOG="/var/log/auth.log"
[ -f "$AUTH_LOG" ] || AUTH_LOG="/var/log/secure"

# Parse login berhasil SSH (Accepted) — 10 terakhir
openssh_log=()
if [ -f "$AUTH_LOG" ]; then
    while read -r line; do
        user=$(echo "$line" | grep -oP 'for (invalid user )?\K\S+' | head -1)
        ip=$(echo "$line" | grep -oP 'from \K[0-9a-fA-F.:]+')
        ts=$(echo "$line" | cut -d' ' -f1-2)
        [ -n "$user" ] && openssh_log+=("ssh $user $ip $(get_isp) $ts")
    done < <(grep "Accepted" "$AUTH_LOG" 2>/dev/null | tail -10)
fi

# Parse login gagal (Failed password / Invalid user) — 10 terakhir
failed_log=()
if [ -f "$AUTH_LOG" ]; then
    while read -r line; do
        user=$(echo "$line" | grep -oP 'invalid user \K\S+|Failed password for \K\S+' | head -1)
        ip=$(echo "$line" | grep -oP 'from \K[0-9a-fA-F.:]+')
        ts=$(echo "$line" | cut -d' ' -f1-2)
        [ -n "$user" ] && failed_log+=("fail $user $ip $(get_isp) $ts")
    done < <(grep -E "Failed password|Invalid user" "$AUTH_LOG" 2>/dev/null | tail -10)
fi

# Sesi aktif saat ini (who)
active_log=()
while read -r user tty ip when _; do
    active_log+=("who $user ${ip:-local} - $(get_isp) $when")
done < <(who | awk '{print $1, $2, $(NF-2), $3, $4, $5, $6}' 2>/dev/null)

echo -e "${GREEN}┌──────────────────────────────────────────┐${NC}"
figlet -f small "Login Time" 2>/dev/null || echo "Login Time"
echo -e "${GREEN}└──────────────────────────────────────────┘${NC}"

echo -e "${GREEN}┌── SESI AKTIF ───────────────────────────┐${NC}"
printf "${YELLOW}%-8s %-16s %-18s %-10s${NC}\n" "TYPE" "User" "IP" "Time"
for log in "${active_log[@]}"; do
    IFS=' ' read -r t user ip isp time <<< "$log"
    printf "${GREEN}%-8s %-16s %-18s %-10s${NC}\n" "$t" "$user" "$ip" "$time"
done
echo -e "${GREEN}└──────────────────────────────────────────┘${NC}"

echo -e "${GREEN}┌── OPENSSH LOGIN BERHASIL (10 TERAKHIR) ─┐${NC}"
printf "${YELLOW}%-8s %-16s %-18s %-10s %-16s${NC}\n" "TYPE" "User" "IP" "ISP" "Time"
for log in "${openssh_log[@]}"; do
    IFS=' ' read -r t user ip isp time <<< "$log"
    printf "${GREEN}%-8s %-16s %-18s %-10s %-16s${NC}\n" "$t" "$user" "$ip" "$isp" "$time"
done
echo -e "${GREEN}└──────────────────────────────────────────┘${NC}"

echo -e "${RED}┌── LOGIN GAGAL (10 TERAKHIR) ────────────┐${NC}"
printf "${YELLOW}%-8s %-16s %-18s %-10s %-16s${NC}\n" "TYPE" "User" "IP" "ISP" "Time"
for log in "${failed_log[@]}"; do
    IFS=' ' read -r t user ip isp time <<< "$log"
    printf "${RED}%-8s %-16s %-18s %-10s %-16s${NC}\n" "$t" "$user" "$ip" "$isp" "$time"
done
echo -e "${RED}└──────────────────────────────────────────┘${NC}"

# Output non-interaktif (dipanggil API): tetap keluar tanpa read
if [ -t 0 ]; then
    read -p "${YELLOW}Press Enter to exit...${NC}" _
fi
exit 0
