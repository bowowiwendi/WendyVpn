function fun_bar() {
    CMD[0]="$1"
    CMD[1]="$2"
    (
        [[ -e $HOME/fim ]] && rm $HOME/fim
        ${CMD[0]} -y >/dev/null 2>&1
        ${CMD[1]} -y >/dev/null 2>&1
        touch $HOME/fim
    ) >/dev/null 2>&1 &
    tput civis
    # Modern spinner
    spinner=("⣾" "⣽" "⣻" "⢿" "⡿" "⣟" "⣯" "⣷")
    while true; do
        for symbol in "${spinner[@]}"; do
            printf "\r ${BICyan}%s ${BIWhite}Processing...${NC}" "$symbol"
            sleep 0.1
        done
        [[ -e $HOME/fim ]] && rm $HOME/fim && break
    done
    printf "\r ${BIGreen}✓ Completed!${NC}          \n"
    tput cnorm
}

function update_core(){
    clear
    echo -e "${BICyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BIWhite}         UPDATE CONFIG LAYANAN             ${NC}"
    echo -e "${BICyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BIYellow}Hanya update config layanan (wendy-api/nginx/haproxy). Tidak menyentuh file script menu — gunakan menu 09 untuk update script.${NC}"
    echo -e ""
    echo -e "${BIYellow}Backing up current configs...${NC}"
    mkdir -p /root/backup-config
    cp /usr/local/bin/wendy-api.py /root/backup-config/wendy-api.py.bak 2>/dev/null
    cp /etc/haproxy/haproxy.cfg /root/backup-config/haproxy.cfg.bak 2>/dev/null
    cp /etc/nginx/conf.d/xray.conf /root/backup-config/xray.conf.bak 2>/dev/null
    echo -e "${BIGreen}✓ Backup saved to /root/backup-config/${NC}"
    echo -e ""

    # 1. Install/Update wendy-api
    echo -e "${BIYellow}[1/4] Installing/Updating wendy-api...${NC}"

    # Download service file if missing
    if [ ! -f /etc/systemd/system/wendy-api.service ]; then
        wget -q -O /etc/systemd/system/wendy-api.service "${Repo}files/wendy-api.service" 2>/dev/null
        if [ -f /etc/systemd/system/wendy-api.service ]; then
            systemctl daemon-reload
            echo -e "${BIGreen}  ✓ service file created${NC}"
        fi
    fi

    # Create config directory and token if missing
    mkdir -p /etc/wendy-api
    if [ ! -f /etc/wendy-api/token ]; then
        openssl rand -hex 24 >/etc/wendy-api/token
        chmod 600 /etc/wendy-api/token
        echo -e "${BIYellow}  ✓ API token created: $(cat /etc/wendy-api/token)${NC}"
    fi

    # Download wendy-api.py
    wget -q -O /usr/local/bin/wendy-api.py "${Repo}files/wendy-api.py" 2>/dev/null
    if [ $? -ne 0 ]; then
        echo -e "${BIRed}✗ Download failed, restoring backup${NC}"
        cp /root/backup-config/wendy-api.py.bak /usr/local/bin/wendy-api.py 2>/dev/null
    else
        chmod +x /usr/local/bin/wendy-api.py
        systemctl enable --now wendy-api 2>/dev/null
        systemctl restart wendy-api 2>/dev/null
        if systemctl is-active --quiet wendy-api; then
            echo -e "${BIGreen}✓ wendy-api running on http://127.0.0.1:9000${NC}"
        else
            echo -e "${BIRed}✗ wendy-api failed to start, check: journalctl -u wendy-api${NC}"
        fi
    fi
    echo -e ""

    # 2. Update xray.conf & fix nginx ports SEBELUM haproxy start
    echo -e "${BIYellow}[2/4] Updating xray.conf & fixing nginx ports...${NC}"
    # Download nginx.conf (pastikan tidak include sites-enabled)
    wget -q -O /etc/nginx/nginx.conf "${Repo}cfg_conf_js/nginx.conf" 2>/dev/null
    wget -q -O /etc/nginx/conf.d/xray.conf "${Repo}cfg_conf_js/xray.conf" 2>/dev/null
    if [ $? -ne 0 ]; then
        echo -e "${BIRed}✗ Download failed, restoring backup${NC}"
        cp /root/backup-config/xray.conf.bak /etc/nginx/conf.d/xray.conf 2>/dev/null
    else
        domain=$(cat /etc/xray/domain 2>/dev/null || echo "")
        if [ -n "$domain" ]; then
            sed -i "s/xxx/${domain}/g" /etc/nginx/conf.d/xray.conf 2>/dev/null
        fi
    fi

    # Hapus default site nginx + semua file yg mungkin ada di sites-enabled
    rm -f /etc/nginx/sites-enabled/* /etc/nginx/sites-available/default 2>/dev/null

    # Fix port 80/443 di SEMUA nginx config
    NGINX_CONF=$(grep -rlE 'listen (80|443)' /etc/nginx/ 2>/dev/null)
    if [ -n "$NGINX_CONF" ]; then
        echo -e "${BIYellow}  Nginx pakai 80/443 → pindah ke 81/8443${NC}"
        while IFS= read -r f; do
            sed -i \
                -e 's/listen\s*80\b/listen 81/g' \
                -e 's/listen\s*443\s*ssl/listen 8443 ssl/g' \
                -e 's/\[::]:80/\[::]:81/g' \
                -e 's/\[::]:443 ssl/\[::]:8443 ssl/g' "$f" 2>/dev/null
        done <<< "$NGINX_CONF"
    fi

    # Verifikasi: pastikan tidak ada listen 80/443 sama sekali
    if grep -qrE 'listen (80|443)' /etc/nginx/ 2>/dev/null; then
        echo -e "${BIRed}  ⚠ Masih ada file dengan port 80/443!${NC}"
        grep -rlE 'listen (80|443)' /etc/nginx/ 2>/dev/null | while read f; do
            echo -e "  ${BIRed}$f${NC}"
        done
    else
        echo -e "${BIGreen}  ✓ Tidak ada config dengan port 80/443${NC}"
    fi

    # Systemd: nginx jalan SETELAH haproxy (Wants= biar ga strict)
    mkdir -p /etc/systemd/system/nginx.service.d
    cat > /etc/systemd/system/nginx.service.d/order.conf << 'SYSDFIX'
[Unit]
After=haproxy.service
Wants=haproxy.service
SYSDFIX
    systemctl daemon-reload 2>/dev/null
    echo -e "${BIYellow}  ✓ systemd: nginx → after haproxy${NC}"

    # Restart nginx (port 81/8443 bukan 80/443)
    nginx -t 2>/dev/null
    if [ $? -eq 0 ]; then
        systemctl restart nginx 2>/dev/null && echo -e "${BIGreen}✓ nginx running (port 81/8443)${NC}" || echo -e "${BIRed}✗ nginx restart failed${NC}"
    else
        echo -e "${BIRed}✗ Nginx config error, restore backup${NC}"
        cp /root/backup-config/xray.conf.bak /etc/nginx/conf.d/xray.conf 2>/dev/null
        nginx -t 2>/dev/null && systemctl restart nginx 2>/dev/null
    fi
    echo -e ""

    # 3. Update haproxy.cfg (port 80/443 sudah free karena nginx pindah)
    echo -e "${BIYellow}[3/4] Updating haproxy.cfg...${NC}"
    domain=$(cat /etc/xray/domain 2>/dev/null || echo "")
    wget -q -O /etc/haproxy/haproxy.cfg "${Repo}cfg_conf_js/haproxy.cfg" 2>/dev/null
    if [ $? -ne 0 ]; then
        echo -e "${BIRed}✗ Download failed, restoring backup${NC}"
        cp /root/backup-config/haproxy.cfg.bak /etc/haproxy/haproxy.cfg 2>/dev/null
    else
        sed -i "s/xxx/${domain}/g" /etc/haproxy/haproxy.cfg 2>/dev/null
        if [ ! -f /etc/haproxy/hap.pem ]; then
            cat /etc/xray/xray.crt /etc/xray/xray.key 2>/dev/null | tee /etc/haproxy/hap.pem >/dev/null && \
                echo -e "${BIYellow}  hap.pem created${NC}"
        fi
        # Remove chroot jika ada
        sed -i '/^[[:space:]]*chroot/d' /etc/haproxy/haproxy.cfg 2>/dev/null
        echo -e "${BIYellow}  Validating haproxy config...${NC}"
        haproxy -c -f /etc/haproxy/haproxy.cfg 2>/dev/null
        if [ $? -eq 0 ]; then
            systemctl restart haproxy 2>/dev/null && echo -e "${BIGreen}✓ haproxy running (port 80/443)${NC}" || echo -e "${BIRed}✗ restart failed${NC}"
        else
            echo -e "${BIRed}✗ Config invalid, restoring backup${NC}"
            cp /root/backup-config/haproxy.cfg.bak /etc/haproxy/haproxy.cfg 2>/dev/null
            systemctl restart haproxy 2>/dev/null
        fi
    fi
    echo -e ""

    # 4. Final verification
    echo -e "${BIYellow}[4/4] Verifikasi...${NC}"
    for svc in nginx haproxy wendy-api; do
        if systemctl is-active --quiet "$svc"; then
            echo -e "${BIGreen}✓ $svc running${NC}"
        else
            echo -e "${BIRed}✗ $svc DOWN${NC}"
        fi
    done

    echo -e ""
    echo -e "${BICyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BIGreen}✓ Update core selesai${NC}"
    echo -e "${BIYellow}Backup disimpan di /root/backup-config/${NC}"
    echo -e "${BICyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    sleep 2
    menu
}

function edit_figlet_text(){
    clear
    echo -e "${BICyan}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
