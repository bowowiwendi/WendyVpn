#!/bin/bash
export HOME=/root
export TERM=xterm

RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'
domain=$(cat /etc/xray/domain)
MYIP=$(wget -qO- ipinfo.io/ip);
clear

read -p "Username : " User
read -p "Day Extend : " Days

# Check user exists in database
db_line=$(grep "^### $User " /etc/ssh/.ssh.db)
if [ -z "$db_line" ]; then
    echo -e "${RED}User $User not found in database!${NC}"
    exit 1
fi

# Extract password and old expiry from db
pw=$(echo "$db_line" | cut -d ' ' -f 3)
limit_ip=$(echo "$db_line" | cut -d ' ' -f 4)
old_exp=$(echo "$db_line" | cut -d ' ' -f 5)

# Calculate new expiry
Today=$(date +%s)
Days_Detailed=$(( Days * 86400 ))
Expire_On=$(( Today + Days_Detailed ))
Expiration=$(date -u --date="1970-01-01 $Expire_On sec GMT" +%Y-%m-%d)
Expiration_Display=$(date -u --date="1970-01-01 $Expire_On sec GMT" '+%d %b %Y')

# Update system user expiry
passwd -u "$User" 2>/dev/null
usermod -e "$Expiration" "$User"

# Update database
sed -i "/^### $User /c\### $User $pw $limit_ip $Expiration" /etc/ssh/.ssh.db

# Regenerate account text file
mkdir -p /var/www/html
cat > /var/www/html/ssh-$User.txt <<-END

━━━━━━━━━━━━━━━━━━━━━━
🔐 SSH OVPN ACCOUNT
━━━━━━━━━━━━━━━━━━━━━━
👤 Username  : $User
🔑 Password  : $pw
🌐 Host      : $domain
📱 Limit IP  : $limit_ip
⏳ Expired   : $Expiration_Display

OpenSSH  → $domain:80@$User:$pw
SSH WS   → $domain:443@$User:$pw
SSH UDP  → $domain:1-65535@$User:$pw
🔗 Save    : https://$domain:81/ssh-$User.txt
━━━━━━━━━━━━━━━━━━━━━━

END

# Output result for API
echo "━━━━━━━━━━━━━━━━━━━━━━"
echo "🔐 SSH OVPN RENEWED"
echo "━━━━━━━━━━━━━━━━━━━━━━"
echo "👤 Username  : $User"
echo "🔑 Password  : $pw"
echo "🌐 Host      : $domain"
echo "📱 Limit IP  : $limit_ip"
echo "⏳ Expired   : $Expiration_Display"
echo "━━━━━━━━━━━━━━━━━━━━━━"

function send_log() {
TIMES="10"
CHATID=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 3)
KEY=$(grep -E "^#bot# " "/etc/bot/.bot.db" | cut -d ' ' -f 2)
URL="https://api.telegram.org/bot$KEY/sendMessage"
TEXT2="
<code>───────────────────────────</code>
      ✨SUCCES RENEW  SSH✨
<code>───────────────────────────</code>
USERNAME: <code>$User</code>
Expired On: <code>$Expiration_Display</code>
Domain: <code>$domain</code>
<code>───────────────────────────</code>
"
curl -s --max-time $TIMES -d "chat_id=$CHATID&disable_web_page_preview=1&text=$TEXT2&parse_mode=html" $URL >/dev/null
}
send_log
