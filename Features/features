#!/bin/bash
clear

C='\033[0;36m'
W='\033[1;37m'
G='\033[1;32m'
Y='\033[1;33m'
R='\033[1;31m'
NC='\033[0m'

function run(){
clear
domain=$(cat /etc/xray/domain)
IPVPS=$(curl -s ipv4.icanhazip.com)
cores=$(awk -F: '/model name/ {core++} END {print core}' /proc/cpuinfo)
tram=$(free -m | awk 'NR==2 {print $2}')

openssh=$(systemctl status ssh | grep Active | awk '{print $3}' | sed 's/(//g' | sed 's/)//g')
ssh_ws=$(systemctl status ws | grep Active | awk '{print $3}' | sed 's/(//g' | sed 's/)//g')
xray=$(systemctl status xray | grep Active | awk '{print $3}' | sed 's/(//g' | sed 's/)//g')
nginx=$(systemctl status nginx | grep Active | awk '{print $3}' | sed 's/(//g' | sed 's/)//g')

status() {
    if [[ $1 == "running" ]]; then
        echo -e "${G}Active${NC}"
    else
        echo -e "${R}Inactive${NC}"
    fi
}

echo -e "${C}┌─────────────────────────────────────────────┐${NC}"
echo -e "${C}│${NC} ${W}SYSTEM MONITOR${NC}           ${W}IP:${C}$IPVPS${NC}"
echo -e "${C}│${NC} ${W}Domain:${C}$domain${NC}"
echo -e "${C}│${NC} ${W}CPU:${C}$cores${NC} Core    ${W}RAM:${C}$tram${NC} MB"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} SSH: $(status $openssh)   WS: $(status $ssh_ws)"
echo -e "${C}│${NC} Xray: $(status $xray)  Nginx: $(status $nginx)"
echo -e "${C}└─────────────────────────────────────────────┘${NC}"
echo ""
read -n 1 -s -r -p "${C}Press any key to return to menu...${NC}"
features
}

function features() {
clear
echo -e "${C}┌─────────────────────────────────────────────┐${NC}"
echo -e "${C}│${NC}         ${W}FEATURES - SYSTEM CONTROL${NC}"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}MONITORING${NC}"
echo -e "${C}│${NC}  ${G}1.${NC}  Running Service Status"
echo -e "${C}│${NC}  ${G}2.${NC}  System Monitor (gotop)"
echo -e "${C}│${NC}  ${G}3.${NC}  Speedtest"
echo -e "${C}│${NC}  ${G}4.${NC}  Check Bandwidth"
echo -e "${C}│${NC}  ${G}5.${NC}  Info Port"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}SERVICE${NC}"
echo -e "${C}│${NC}  ${G}6.${NC}  Restart All Services"
echo -e "${C}│${NC}  ${G}7.${NC}  Fix HAProxy"
echo -e "${C}│${NC}  ${G}8.${NC}  Fix Dropbear"
echo -e "${C}│${NC}  ${G}9.${NC}  Limit Speed"
echo -e "${C}│${NC}  ${G}10.${NC} Limit IP Xray"
echo -e "${C}│${NC}  ${G}11.${NC} Limit IP SSH"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}NETWORK & DOMAIN${NC}"
echo -e "${C}│${NC}  ${G}12.${NC} Change Domain"
echo -e "${C}│${NC}  ${G}13.${NC} Menu Pointing"
echo -e "${C}│${NC}  ${G}14.${NC} Fix Pointing Domain"
echo -e "${C}│${NC}  ${G}15.${NC} Install SlowDNS"
echo -e "${C}│${NC}  ${G}16.${NC} Install WARP"
echo -e "${C}│${NC}  ${G}17.${NC} Install DNS Media"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}INSTALL TOOLS${NC}"
echo -e "${C}│${NC}  ${G}18.${NC} Install Panel"
echo -e "${C}│${NC}  ${G}19.${NC} Install Noobz VPN"
echo -e "${C}│${NC}  ${G}20.${NC} Uninstall Noobz VPN"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}MAINTENANCE${NC}"
echo -e "${C}│${NC}  ${G}21.${NC} Clear Cache"
echo -e "${C}│${NC}  ${G}22.${NC} Clear Log"
echo -e "${C}│${NC}  ${G}23.${NC} Auto Delete Expired"
echo -e "${C}│${NC}  ${G}24.${NC} Auto Reboot"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC} ${Y}UTILITIES${NC}"
echo -e "${C}│${NC}  ${G}25.${NC} Register VPS"
echo -e "${C}│${NC}  ${G}26.${NC} Change Banner"
echo -e "${C}│${NC}  ${G}27.${NC} System Settings"
echo -e "${C}├─────────────────────────────────────────────┤${NC}"
echo -e "${C}│${NC}  ${R}x.${NC}  Exit"
echo -e "${C}└─────────────────────────────────────────────┘${NC}"
echo ""
echo -ne "${C}Select option: ${NC}"
read menu

case $menu in
1) clear ; run ;;
2) clear ; gotop ;;
3) clear ; speedtest ;;
4) clear ; bw ;;
5) clear ; prot ;;
6) clear ; reset ;;
7) clear ; fixhap ;;
8) clear ; wget https://raw.githubusercontent.com/bowowiwendi/WendyVpn/ABSTRAK/fix.sh && chmod +x fix.sh && ./fix.sh ;;
9) clear ; limitspeed ;;
10) clear ; onoff ;;
11) clear ; on-offssh ;;
12) clear ; addhost ;;
13) clear ; menu_cf.sh ;;
14) clear ; fixcert ;;
15) clear ; rm -rf install; apt update; wget https://github.com/khaledagn/SlowDNS/raw/main/install; chmod 777 install; ./install --start ;;
16) clear ; bash warp.sh wg6 ;;
17) clear ; media ;;
18) clear ; m-panel ;;
19) clear ; git clone https://github.com/noobz-id/noobzvpns.git && cd noobzvpns/ && ./install.sh ;;
20) clear ; git clone https://github.com/noobz-id/noobzvpns.git && cd noobzvpns/ && ./uninstall.sh ;;
21) clear ; clearcache ;;
22) clear ; clearlog ;;
23) clear ; auto-delet.sh ;;
24) clear ; autoreboot ;;
25) clear ; add-ip ;;
26) clear ; nano /etc/banner.txt ;;
27) clear ; nano /etc/sysctl.conf ;;
x|X) clear ; exit 0 ;;
*) clear ; echo -e "${R}Invalid option!${NC}" ; sleep 1 ; features ;;
esac
}

features
